+%if BZ_BAL_ESH == 1
+; bz_eshift - A (SPEC.md 128.38.10): the entry at AX (shift 0, mask 16 rows
+; then frame 16 rows, in the ball part bz_bsegs[bz_mat]) moved BL = s (1 - 3)
+; pixels right into the part's scratch, BZ_BAL_SCROFF - the mask filling with
+; kept pixels, the frame with 0 - so bz_blit, bz_fdis and the boxes read it
+; as a stored entry at shift s.  -> AX = BZ_BAL_SCROFF.  Preserves BX.
+; Clobbers CX, DX.
+bz_eshift:
+    push bx
+    push si
+    push di
+    push bp
+    push es
+    mov si, ax
+    mov bh, bl                  ; BH = s, the pixels
+    mov bl, [bz_mat]
+    push bx
+    xor bh, bh
+    shl bx, 1
+    mov es, [bz_bsegs + bx]
+    pop bx
+    mov di, BZ_BAL_SCROFF
+    mov ch, 0C0h                ; the mask's fill, a pixel at a time
+    mov bp, 2 * BZ_BAL_ROWS
+.r:
+    cmp bp, BZ_BAL_ROWS
+    jne .g
+    xor ch, ch                  ; the frame's
+.g:
+    mov ax, [es:si]
+    mov dx, [es:si + 2]
+    mov cl, [es:si + 4]
+    mov bl, bh
+.b:
+    shr al, 1
+    rcr ah, 1
+    rcr dl, 1
+    rcr dh, 1
+    rcr cl, 1
+    shr al, 1
+    rcr ah, 1
+    rcr dl, 1
+    rcr dh, 1
+    rcr cl, 1
+    or al, ch
+    dec bl
+    jnz .b
+    mov [es:di], ax
+    mov [es:di + 2], dx
+    mov [es:di + 4], cl
+    add si, BZ_BAL_RB
+    add di, BZ_BAL_RB
+    dec bp
+    jnz .r
+    mov ax, BZ_BAL_SCROFF
+    pop es
+    pop bp
+    pop di
+    pop si
+    pop bx
+    ret
