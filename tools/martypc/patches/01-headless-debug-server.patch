diff --git a/crates/binaries/martypc_headless/src/lib.rs b/crates/binaries/martypc_headless/src/lib.rs
index e1680ee..3f9c952 100644
--- a/crates/binaries/martypc_headless/src/lib.rs
+++ b/crates/binaries/martypc_headless/src/lib.rs
@@ -32,6 +32,7 @@
 #![forbid(unsafe_code)]
 
 mod cpu_test;
+mod debug_server;
 mod emulator;
 
 mod run_benchmark;
@@ -740,9 +741,52 @@ pub fn run() {
     // Start emulator
     emu.start();
 
-    // TODO: We don't have any backend to run an event loop. If we want to actually run the
-    //       emulator now we need some way of controlling / stopping it.
-    log::debug!("Headless operation not implemented. Exiting.");
+    // The debug server is the backend the TODO here always wanted: something
+    // that both DRIVES the machine and can STOP it. Without one there is
+    // nothing for a headless frontend to do but exit, which is what it used
+    // to do.
+    //
+    // It is opt-in through the environment rather than through
+    // ConfigFileParams on purpose, for now: it keeps this addition inside one
+    // crate and one module, and an address on the command line is what a test
+    // harness wants to vary per run anyway. A config key is the shape this
+    // should take if it is ever wanted permanently.
+    match std::env::var("MARTYPC_DEBUG_ADDR") {
+        Ok(addr) if !addr.is_empty() => match debug_server::DebugServer::bind(&addr) {
+            Ok(mut server) => {
+                // Honour --mount fd:N:path / [[emulator.media.floppy]]. The
+                // config has always been parsed; in a headless run nothing
+                // ever acted on it.
+                if let Some(floppies) = emu.config.emulator.media.floppy.as_ref() {
+                    let entries: Vec<(usize, String)> =
+                        floppies.iter().map(|f| (f.drive, f.filename.clone())).collect();
+                    for (drive, filename) in entries {
+                        if let Err(e) =
+                            debug_server::mount_floppy(&mut emu.machine, drive, std::path::Path::new(&filename))
+                        {
+                            log::error!("Could not mount floppy {}: {}", filename, e);
+                        }
+                    }
+                }
+                if let Ok(wav) = std::env::var("MARTYPC_WAV") {
+                    if !wav.is_empty() {
+                        server.capture_audio(&emu.machine, &wav);
+                    }
+                }
+                log::info!("Headless debug server on {}. Machine starts PAUSED.", addr);
+                server.run_loop(&mut emu.machine);
+                log::info!("Debug server exiting.");
+                std::process::exit(0);
+            }
+            Err(e) => {
+                log::error!("Could not bind debug server to {}: {}", addr, e);
+                std::process::exit(1);
+            }
+        },
+        _ => {}
+    }
+
+    log::debug!("Headless operation not implemented (set MARTYPC_DEBUG_ADDR). Exiting.");
 
     std::process::exit(0);
 }
