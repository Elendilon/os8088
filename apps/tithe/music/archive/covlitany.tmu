; ARCHIVED - out of the manifest (tools/os88tithemus.py's SONGS) and so out
; of the MUSIC part. Put the name back in SONGS to hear it again. Why:
; the owner picked INTERCESSION for the Covenant; Litany kept Vespers'
; tone, and the tone went on into Intercession's bell.
;
; TITHE - THE COVENANT, option 1: LITANY
;
; Vespers' TONE, which the owner kept - a single voice chanting over an organ
; and a pedal, a bell tolling - in a new song and a warmer mode: A dorian, whose
; raised sixth makes D a MAJOR chord, so the chant keeps turning toward the
; light. A healing faction, not a mourning one. 68 BPM, an eighth four ticks.
; A sings round A; B rises to F-sharp above over C, G and D.

song covlitany "Covenant: Litany"
groove 4
unit 8
rows 16
measure 8
voice lead chant
voice bass pedal
voice chord organ

; --- the intonation -------------------------------------------------------------
lead LI = o4 e4 a4 b4 >c4< | b2 a2 |
bass BI = o2 a1 | a1 |
chord CI = o3 r1 | [e a >c]1 |
drum DI = B1 | r1 |

; --- A --------------------------------------------------------------------------
lead LA1 = o4 a4 b8 >c8 d4 c4< | b4 a4 f+2 |
lead LA2 = o4 e4 a4 b4 >c4< | b2 g2 |
lead LA3 = o5 c4 d4 e4 c4 | d4 c8< b8 a4 f+4 |
lead LA4 = o4 g4 e4 f+4 d4 | a2. r4 |
; --- B: up to F-sharp ------------------------------------------------------------
lead LB1 = o5 e4 e4 d4 c4 | d2< b2 |
lead LB2 = o4 a4 >d4 f+4 e4 | e2 c2< |
lead LB3 = o5 c4< b4 a4 g4 | f+4 a4 >d4 c4< |
lead LB4 = o4 b4 g4 a4 f+4 | a2. r4 |

bass BA1 = o2 a1 | d1 |
bass BA2 = o2 a1 | g1 |
bass BA3 = o2 c1 | d1 |
bass BA4 = o2 e2 d2 | a1 |
bass BB1 = o2 c1 | g1 |
bass BB2 = o2 d1 | a1 |
chord CA1 = o3 [e a >c]1 | [d f+ a]1 |
chord CA2 = o3 [e a >c]1 | [d g b]1 |
chord CA3 = o3 [e g >c]1 | [d f+ a]1 |
chord CA4 = o3 [e g b]2 [d f+ a]2 | [e a >c]1 |
chord CB1 = o3 [e g >c]1 | [d g b]1 |
chord CB2 = o3 [d f+ a]1 | [e a >c]1 |

drum DT = B1 | r1 |
drum DD = b1 | r1 |
drum DF = B2 b2 | B1 |

order LI BI CI DI
order LA1 BA1 CA1 DT          ; 1: the loop comes back here
order LA2 BA2 CA2 DT
order LA3 BA3 CA3 DT
order LA4 BA4 CA4 DF
order LB1 BB1 CB1 DT
order LB2 BB2 CB2 DD
order LB3 BA3 CA3 DT
order LB4 BA4 CA4 DF
loop 1
