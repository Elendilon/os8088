; TITHE - the RESOLUTION, option 2: THE TOLL
;
; The same D and the same open fifths as the other two (reswar.tmu says why),
; but ominous and at the planning themes' own pulse - 91 BPM, a 16th three
; ticks - so the cut changes the WEATHER and not the clock. A bell tolls D on
; every downbeat, the timpani roll under it, and the bass leans on E-flat, the
; flat second: phrygian, the colour of a reckoning. The choir holds long notes
; high above it, so the speaker's one voice is a line with room around it.

song restoll "Resolution: The Toll"
groove 3
unit 16
rows 16
measure 16
voice lead choir
voice bass bass
voice chord strings

lead RH = o5 d4 r4 r2 |
bass BH = o2 d1 |
chord CH = o3 [d a]1 |
drum DH = b4 t8 t8 k4 t16 t16 t16 t16 |

lead R1 = o5 d2 r4 e-4 |
lead R2 = o5 d2. r4 |
lead R3 = o4 a2 r4 b-4 |
lead R4 = o4 a2. r4 |
bass B1 = o2 d4. e-8 d2 |
bass B2 = o2 d4. e-8 d4 <a4> |
chord C1 = o3 [d a]1 |
chord C2 = o3 [d g]1 |
drum D1 = b4 t8 t8 t4 t16 t16 t16 t16 |
drum D2 = b4 t8 t8 t4 T8 T8 |

lead RT = o4 d2 a2 |
bass BT = o2 d2 <a2> |
chord CT = o3 [d a >d]1 |
drum DT = b4 t8 t8 k4 r4 |

; --- THE SPEAKER'S OWN LEAD (SPEC.md 97.10.7): every bar is the whole piece in
; one voice - the TOLL struck on the downbeat, the timpani as two low blips,
; the bass's D and its leaning E-flat, then the choir's note - where the FM
; lead's long notes with rests between were the only part the speaker had.
lead SH = @spbell o5 d4 @sdrum o2 a16 r16 a16 r16 d16 r16 d16 r16 a16 a16 a16 a16 |
lead S1 = @spbell o5 d4 @sdrum o2 a16 r16 a16 r16 @choir o3 d8. e-16 o5 e-4 |
lead S2 = @spbell o5 d4 @sdrum o2 a16 r16 a16 r16 @choir o3 d8. e-16 d8 o2 a8 |
lead S3 = @spbell o5 d4 @sdrum o2 a16 r16 a16 r16 @choir o3 d8. e-16 o4 b-4 |
lead S4 = @spbell o5 d4 @sdrum o2 a16 r16 a16 r16 a16 r16 o3 d16 d16 @choir o4 a4 |
lead ST = @spbell o5 d4 @sdrum o2 a16 r16 a16 r16 @choir o4 a4 @sdrum o2 d16 r16 r8 |

order RH BH CH DH SH
order R1 B1 C1 D1 S1          ; 1: the loop
order R2 B2 C2 D1 S2
order R3 B1 C1 D1 S3
order R4 B2 C2 D2 S4
order RT BT CT DT ST          ; 5: the tail
loop 1
tail 5
