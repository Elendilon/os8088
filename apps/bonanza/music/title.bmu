; BOUNCE BONANZA - song 0, the TITLE: "Bounce Bonanza" (SPEC.md 128.20)
;
; F major at 136.5 BPM - a 16th is one row of SIX sub-ticks (110 ms), a
; multiple of three, so the desktop's timer (three sub-ticks a system tick)
; plays it exactly (`desktop`).
;
; The intro is a BALL: five notes falling down an F chord, each sooner than
; the last - a bounce settling - then the trumpet's fanfare climbing back up.
; A is the theme, an arpeggio that leaps like the ball, over a bouncing
; octave bass and off-beat chord stabs (ska's "and"). B turns to D minor on
; the horn, longer notes and a pedal under them, then builds back into A.
; Intro, A A' B for ever.

song title "Bounce Bonanza"
desktop
groove 6
unit 16
rows 32
measure 16
spkbass
voice lead trumpet
voice bass pluckbass
voice chord stab

; --- the intro: the ball bounces down and settles, the fanfare ----------------
lead LI1 = o6 v14 c4. o5 a4 f8. c8 o4 a16 | v13 f4 r8 f16 g16 a8 o5 c8 f4 |
bass BI1 = o2 r2 r4 r8 c8 | f8 o3 f8 o2 f8 o3 f8 o2 c8 o3 c8 o2 c8 e8 |
chord CI1 = o4 r1 | [f a >c]4 r8 [f a >c]8 r8 [e g >c]8 [e g >c]4 |
drum DI1 = t4. T4 t8. T8 t16 | k8 h8 s8 h8 k8 s16 s16 s8 s8 |

; --- A: the theme ---------------------------------------------------------------
lead LA1 = @chip v13 o4 f8 a8 o5 c8 o4 a8 f8 o5 c8 o4 a4 | g8. a16 b-8 o5 d8 c4 o4 a4 |
lead LA2 = @chip v13 o4 b-8 o5 d8 f8 d8 o4 b-8 o5 d8 c4 | o4 a8. b-16 o5 c8 o4 a8 @chiparp g4 @chip r4 |
lead LA3 = @chip v13 o4 f8 a8 o5 c8 o4 a8 f8 o5 c8 f4 | e8. d16 c8 o4 b-8 a4 o5 c4 |
lead LA4 = @chip v13 o4 b-8 o5 d8 c8 o4 b-8 a8 g8 a8 b-8 | @chiparp a4 @chip g8 e8 f4 r4 |
bass BA1 = o2 f8 o3 f8 o2 f8 o3 f8 o2 f8 o3 f8 o2 f8 o3 f8 | o2 c8 o3 c8 o2 c8 o3 c8 o2 c8 o3 c8 o2 c8 e8 |
bass BA2 = o2 b-8 o3 b-8 o2 b-8 o3 b-8 o2 b-8 o3 b-8 o2 b-8 o3 b-8 | o2 f8 o3 f8 o2 f8 o3 f8 o2 c8 o3 c8 o2 c8 e8 |
bass BA4 = o2 b-8 o3 b-8 o2 b-8 o3 b-8 o2 c8 o3 c8 o2 c8 o3 c8 | o2 f8 o3 c8 o2 c8 e8 f4 r4 |
chord CA1 = o4 r8 [f a >c]8 r8 [f a >c]8 r8 [f a >c]8 r8 [f a >c]8 | r8 [e g b-]8 r8 [e g b-]8 r8 [e g >c]8 r8 [e g >c]8 |
chord CA2 = o4 r8 [d f b-]8 r8 [d f b-]8 r8 [d f b-]8 r8 [d f b-]8 | r8 [f a >c]8 r8 [f a >c]8 r8 [e g >c]8 r8 [e g b-]8 |
chord CA4 = o4 r8 [d f b-]8 r8 [d f b-]8 r8 [e g >c]8 r8 [e g >c]8 | r8 [f a >c]8 r8 [e g b-]8 [f a >c]4 r4 |
drum DA = k8 h8 s8 h8 k8 h8 s8 h8 | k8 h8 s8 h8 k8 k8 s8 h8 |
drum DA4 = k8 h8 s8 h8 k8 h8 s8 h8 | k8 h8 s8 h8 s16 s16 s16 s16 T8 t8 |

; --- B: D minor, on the horn -------------------------------------------------------
lead LB1 = @horn v13 o5 d4. c8 o4 a4 f4 | g4. a8 b-4 a4 |
lead LB2 = @horn v13 o5 c4. o4 b-8 a4 f4 | g2 r4 o5 c4 |
lead LB3 = @horn v13 o5 d4. c8 o4 a4 o5 d4 | e4. f8 g4 e4 |
lead LB4 = @horn v13 o5 f4 e4 d4 c4 | v14 c8 c8 c8 c8 @chiparp c4 @chip r4 |
bass BB1 = o2 l4 d d d d | g g g g |
bass BB2 = o2 l4 f f f f | c c c c |
bass BB3 = o2 l4 d d d d | c c c c |
bass BB4 = o2 l4 b- b- b- b- | c8 c8 c8 c8 c4 r4 |
chord CB1 = o4 [d f a]2 [d f a]2 | [d g b-]2 [d g b-]2 |
chord CB2 = o4 [f a >c]2 [f a >c]2 | [e g >c]2 [e g b-]2 |
chord CB3 = o4 [d f a]2 [d f a]2 | [e g >c]2 [e g >c]2 |
chord CB4 = o4 [d f b-]2 [d f b-]2 | [e g >c]4 [e g >c]4 [e g b-]4 r4 |
drum DB = k4 h8 h8 s4 h8 h8 | k4 h8 k8 s4 h8 h8 |
drum DB4 = k4 h8 h8 s4 h8 h8 | k8 k8 s8 s8 s16 s16 s16 s16 T16 T16 t16 t16 |

order LI1 BI1 CI1 DI1
order LA1 BA1 CA1 DA          ; 1: the loop comes back here
order LA2 BA2 CA2 DA
order LA3 BA1 CA1 DA
order LA4 BA4 CA4 DA4
order LB1 BB1 CB1 DB
order LB2 BB2 CB2 DB
order LB3 BB3 CB3 DB
order LB4 BB4 CB4 DB4
loop 1
