# Course 5 (KITE; docs/plans/bonanza-courses/KITE.md): KITE HILL, a CLIMB - a hill of terraces up the screen
# and the WIND on it.  A gust that shoves (railed: the lesson), a gust across a CRUMBLING BRIDGE, a THERMAL
# that lifts the ball 8.5 units up a cliff, gusts waited out behind WINDBREAKS, and the GLIDE: a pit crossed
# straight up the screen on rising air, the summit across it.  Rubber from start to finish.  REFINED
# (2026-11-25, the step after the pen-in): written by docs/plans/bonanza-courses/kite/sketch.py --bbc --force
# while the layout moves.  NOT in the build yet (no BZ_COURSES entry, no pathway pad).
course KITE "Kite Hill"
guide                     # a REAL course: held to the course guide's checkable rules (G1, G3, G9 - G12)
width 96                  # 768 px: the floors run from px 112 (the summit's wing) to 656 (the breezeway's east end)
origin 528                # NOT free: the camera's lattice is 64 px of the PICTURE, and every flight is framed in
                          # the middle of its window at this origin (KITE.md section 2: 512 and 544 pass G3 too,
                          # 496 and 560 do not).  Move it by 64 or re-run --guide
ball rubber
uses wind glass           # (the crumbling bridge's cracked tiles are GLASS's kind `crack`, SPEC.md 130.25.8)
music kitehill            # its own song (2026-11-25): a 6/8 in D that climbs, each phrase a step higher (KITE.md, "The song")
palette 0                 # green, red, yellow on black: a grassy hill (LITTLE HOP's palette)
limit 90
target 60

# rooms (the sketch's sections), walls and guard rails
floor rect  48  54  55  59  flat 5   # A: the MEADOW, 7 x 5
hole  half left tile 48 58          # a diagonal corner
hole  half down tile 54 58          # a diagonal corner
guard rect  48  54  55  58
guard rect  49  58  54  59
floor rect  50  48  53  54  ramp y 48 54 8 5   # R: the first rise, 3 units in 6 tiles, 3 wide, to a BROW a unit over the walk
floor rect  39  45  53  48  flat 7   # B: the BREEZEWAY, 14 x 3, walked up-left (-x)
floor rect  46  44  47  45  flat 7   # the lesson's fan, in a notch on the upwind side
guard rect  42  47  50  48 side +y
guard rect  42  45  46  46 side -y
guard rect  47  45  51  46 side -y
guard rect  46  44  47  45 side -x -y +x
guard rect  39  45  40  48 side -x
guard rect  51  45  53  46 side -y
guard rect  52  45  53  48 side +x
floor rect  40  40  41  41  flat 7   # C: the crumbling bridge
floor rect  40  41  41  42  flat 7   # C: the crumbling bridge
floor rect  40  42  41  43  flat 7   # C: the crumbling bridge
floor rect  40  43  41  44  flat 7   # C: the crumbling bridge
floor rect  40  44  41  45  flat 7   # C: the crumbling bridge
floor rect  38  42  39  43  flat 7   # the bridge's fan, on a lone pillar upwind (one void cell off the bridge)
floor rect  37  35  42  40  flat 7   # D: the FAN PLAZA, 5 x 5, under the cliff
hole  half right tile 41 35          # a diagonal corner
hole  half down tile 41 39          # a diagonal corner
guard rect  37  35  41  36 side -y
guard rect  41  36  42  39 side +x
guard rect  37  39  40  40 side +y
floor rect  32  35  37  40  flat 15.5   # S: terrace 3, the cliff's top (its +x face is the cliff, 8.5 units)
guard rect  32  35  37  36 side -y
guard rect  32  39  37  40 side +y
guard rect  32  35  33  37 side -x
guard rect  32  39  33  40 side -x
floor rect  21  37  32  39  flat 15.5   # E: the WINDBREAK bridge, 11 x 2, walked up-left (-x)
guard rect  28  38  30  39 side +y
guard rect  24  38  26  39 side +y
floor rect  27  35  28  36  flat 15.5   # the windbreaks' fan, on a lone pillar upwind
floor rect  16  34  21  39  flat 15.5   # F: the LAUNCH PLAZA, 5 x 5, a diamond on the screen
guard rect  16  35  17  39 side -x
guard rect  16  38  21  39 side +y
guard rect  18  34  21  35 side -y
guard rect  20  34  21  37 side +x
floor rect  14  32  15  33  flat 12.5   # P: the glide's fan, on a pillar in the middle of the pit, 3 units down
floor rect  17  29  18  34  ramp y 29 34 18 15.5   # the ROPE WALK: 1 wide round the pit, 2.5 units up in 5 tiles
floor rect  11  28  18  29  flat 18   # the rope walk's top: along the pit's far side to the summit
guard rect  17  28  18  34 side +x
guard rect  11  28  18  29 side -y
floor rect   4  22  11  29  flat 18   # G: the SUMMIT, 7 x 7
hole  half up tile 4 22          # a diagonal corner
guard rect   5  22  11  23 side -y
guard rect   4  23   5  29 side -x
guard rect  10  22  11  28 side +x
guard rect   4  28   9  29 side +y
floor rect   9  29  11  35  flat 18   # the summit's WING: the pit's west side, a landing for a ball that drifts left
guard rect   9  29  10  35 side -x
guard rect   9  34  11  35 side +y
floor rect   6  24   9  27  flat 18.5   # the CROWN: half a unit up (every ball rolls up it), the goal on it
float rect  40  40  41  45 thick 0.5
float rect  21  37  32  39 thick 1
float rect  17  28  18  34 thick 0.5
float rect  11  28  17  29 thick 0.5

prop blower 46 44 face +y region 44 45 48 47 strength 10 gust 64 64 flag
prop crack 40 40
prop crack 40 41
prop crack 40 42
prop crack 40 43
prop crack 40 44
prop blower 38 42 face +x region 39 40 41 44 strength 8 gust 64 192 seed 80
prop blower 38 37 face up region 37 35 38 39 strength 40 top 9 lift
prop blower 27 35 face +y region 22 36 31 38 strength 12 gust 24 104 seed 48
prop blower 14 32 face up region 11 29 16 34 strength 40 top 7
# ART (docs/plans/bonanza-courses/kite/art.py draws the files and places them: ART.md)
art kite_great.bba 66 266
art kite_calm.bba 406 611
art kite_lift.bba 537 576
art kite_shelter.bba 292 402
art kite_launch.bba 231 309
art kite_small0.bba 669 420
art kite_small1.bba 422 320

goal  rect 6 24 9 27  flat 18.5
start 51 57
checkpoint 40 46 ball rubber   # flag 0
checkpoint 34 37 ball rubber   # flag 1
checkpoint 18 36 ball rubber   # flag 2

# clocks: on a corner of a floor off the way, or on a tile one out from it
clock 54 55 frame sock1   # start: limp
clock 41 37 frame sock2   # plaza: half out
clock 16 38 frame sock3   # launch: straight out
clock 7 22 frame sock4   # summit: taut

