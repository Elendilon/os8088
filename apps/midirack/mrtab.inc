; THE SMOOTH TABLES ARE BSS, built once at entry by mrt_unz out of
; MRT_ZTAIL's second differences (SPEC.md 105.6.1). In mrt_unz's order:
; a byte table's last entry spills its high byte onto the next table's
; first, which that table's own expansion then writes
%if MR_BSS & 1
%assign MR_BSS MR_BSS + 1
%endif
    MRBUF mrt_tl,     128    ; MIDI level -> OPL attenuation (0.75 dB steps), 40 log10
    MRBUF mrt_amp,    128    ; MIDI level -> the synth's amplitude, a square law
    MRBUF mrt_fn,     768    ; OPL F-Number at block = octave - 1, 1/32 semitone steps
    MRBUF mrt_fq,     768    ; octave 0's frequency x 2048, the same steps
    MRBUF mrt_pow,    768    ; the wavetable's pitch: 2^(i/384) x 32768, 1/32 semitone

